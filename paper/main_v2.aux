\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Per-dimension bracket-norm corrected values for the 640 RNA-FM embedding dimensions on the HTT CAG region. The distribution is right-skewed: a minority of dimensions carry disproportionately high intensive signal. Dimensions above the median (dashed) are candidates for structural feature extraction.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:bracket_norm}{{1}{5}{Per-dimension bracket-norm corrected values for the 640 RNA-FM embedding dimensions on the HTT CAG region. The distribution is right-skewed: a minority of dimensions carry disproportionately high intensive signal. Dimensions above the median (dashed) are candidates for structural feature extraction}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Grassmannian transportability collapses for any repeat-count change}{5}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces (a)\nobreakspace  {}Geodesic distance from the WT ($r=21$) PCA subspace to each variant. The distance is uniformly $\sim 3.7$ for all non-WT repeat counts, with no gradual degradation or phase transition at the disease threshold ($r \approx 36$). (b)\nobreakspace  {}Principal angle heatmap: nearly all angles exceed $60^\circ $, indicating near-complete subspace rotation.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:transport}{{2}{5}{(a)~Geodesic distance from the WT ($r=21$) PCA subspace to each variant. The distance is uniformly $\sim 3.7$ for all non-WT repeat counts, with no gradual degradation or phase transition at the disease threshold ($r \approx 36$). (b)~Principal angle heatmap: nearly all angles exceed $60^\circ $, indicating near-complete subspace rotation}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Extreme representational compression in later layers}{6}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cross-layer subspace similarity (mean cosine of principal angles between 10-dimensional PCA subspaces). Early layers (0--2) form a coherent block, as do the late layers (9--12). The transition region (layers\nobreakspace  {}3--8) shows progressive divergence from the early block and convergence toward the late block.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:layers}{{3}{6}{Cross-layer subspace similarity (mean cosine of principal angles between 10-dimensional PCA subspaces). Early layers (0--2) form a coherent block, as do the late layers (9--12). The transition region (layers~3--8) shows progressive divergence from the early block and convergence toward the late block}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Weight matrices admit progressive low-rank factorization}{7}{subsection.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces (a)\nobreakspace  {}Effective rank (95\% cumulative variance) by layer and projection type. $W_Q$ and $W_K$ compress $3\times $ from early to late layers; $W_V$ remains high-rank throughout. (b)\nobreakspace  {}Spectral decay ratio $\sigma _1/\sigma _{10}$: higher values indicate stronger concentration of variance in the leading singular directions.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:factorize}{{4}{7}{(a)~Effective rank (95\% cumulative variance) by layer and projection type. $W_Q$ and $W_K$ compress $3\times $ from early to late layers; $W_V$ remains high-rank throughout. (b)~Spectral decay ratio $\sigma _1/\sigma _{10}$: higher values indicate stronger concentration of variance in the leading singular directions}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}CAG repeat region occupies a distinct representational subspace}{7}{subsection.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces (a)\nobreakspace  {}PCA of final-layer RNA-FM embeddings for the HTT CAG region plus flanking sequence. CAG repeat positions (red) separate from flanking positions (blue) along PC1 (98.6\% variance). (b)\nobreakspace  {}Position-wise embedding norm is constant at $28.667$ across all positions, confirming that LayerNorm equalizes magnitudes and structural information resides entirely in direction.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:positions}{{5}{8}{(a)~PCA of final-layer RNA-FM embeddings for the HTT CAG region plus flanking sequence. CAG repeat positions (red) separate from flanking positions (blue) along PC1 (98.6\% variance). (b)~Position-wise embedding norm is constant at $28.667$ across all positions, confirming that LayerNorm equalizes magnitudes and structural information resides entirely in direction}{figure.5}{}}
